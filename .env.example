# Скопируйте файл в .env и заполните обязательные значения.

# Telegram: токен бота и ID административного чата обязательны.
BOT_TOKEN=
ADMINS_CHAT_ID=

# Замените (?!) своими правилами; этот шаблон ничего не блокирует.
BANWORD_REGEX=(?iu)\b((у|[нз]а|(хитро|не)?вз?[ыьъ]|с[ьъ]|(и|ра)[зс]ъ?|(о[тб]|под)[ьъ]?|(.\B)+?[оаеи])?-?([её]б(?!о[рй])|и[пб][ае][тц]).*?|(н[иеа]|([дп]|верт)о|ра[зс]|з?а|с(ме)?|о(т|дно)?|апч)?-?ху([яйиеёю]|ли(?!ган)).*?|(в[зы]|(три|два|четыре)жды|(н|сук)а)?-?бл(я(?!(х|ш[кн]|мб)[ауеыио]).*?|[еэ][дт]ь?)|(ра[сз]|[зн]а|[со]|вы?|п(ере|р[оие]|од)|и[зс]ъ?|[ао]т)?п[иеё]зд.*?|(за)?п[ие]д[аое]?р(ну.*?|[оа]м|(ас)?(и(ли)?[нщктл]ь?)?|(о(ч[еи])?|ас)?к(ой)|юг)[ауеы]?|манд([ауеыи](л(и[сзщ])?[ауеиы])?|ой|[ао]вошь?(е?к[ауе])?|юк(ов|[ауи])?)|((за|вы|под|на|об|по)?трах(ну(сь|ть)?|ни(сь)?|ать|а([юяй]|л([аи])?|н([аыо])?)))|(сучк([уеаи]|ой))|(залуп(([уеаиы]|ой)?))|(жоп([уеыаи]|ой))|муд([яаио].*?|е?н([ьюия]|ей))|мля([тд]ь)?|лять|([нз]а|по)х|м[ао]л[ао]фь([яию]|[еёо]й))\b
SUPERGROUP_BANWORD_REGEX=(?i)(\b([кk][аa][зz3][иi][нn][а-яa-zё]*|казик[а-яё]*|подработ[а-яa-zё]*|п[оo0][рp][нn][а-яa-zё]*|н[аa][рp][кk][а-яa-zё]*|casino)\b|18\+|21\+|\$)
# Срок доверия к участнику в секундах: 7 дней.
IS_TRUSTED_MEMBER=604800

# База данных и порог предупреждений.
DATABASE_NAME=database.db
MAX_WARNINGS=3

# Укажите пути к файлам обученной модели и TF-IDF.
MODEL_PATH=models/spam_classifier.pkl
TFIDF_PATH=models/tfidf_vectorizer.pkl

# Уведомления администрации.
VIOLATION_MESSAGE="Пользователь {nickname} нарушил правила в чате {chat}.\nВот его сообщение:\n\n{message}"

# При необходимости раскомментируйте и настройте прокси.
# PROXY_URL=socks5://127.0.0.1:1080
