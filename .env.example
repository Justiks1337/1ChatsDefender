# Скопируйте файл в .env и заполните обязательные значения.

# Telegram: токен бота и ID административного чата обязательны.
BOT_TOKEN=
ADMINS_CHAT_ID=

# Замените (?!) своими правилами; этот шаблон ничего не блокирует.
BANWORD_REGEX='(?!)'
SUPERGROUP_BANWORD_REGEX='(?!)'
# Срок доверия к участнику в секундах: 7 дней.
IS_TRUSTED_MEMBER=604800

# База данных и порог предупреждений.
DATABASE_NAME=database.db
MAX_WARNINGS=3

# Укажите пути к файлам обученной модели и TF-IDF.
MODEL_PATH=models/spam_classifier.pkl
TFIDF_PATH=models/tfidf_vectorizer.pkl

# Уведомления администрации.
VIOLATION_MESSAGE='Пользователь {nickname} в чате {chat}: {message}'

# При необходимости раскомментируйте и настройте прокси.
# PROXY_URL=socks5://127.0.0.1:1080
